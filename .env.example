# Copy to .env (gitignored).

# Frontend (Vite) — o usar frontend/.env.local
VITE_API_URL=http://localhost:8100

# Backend — cache de modelos PaddleX.
# Si no se define, el arranque usa backend/.paddlex (setdefault en app/main.py).
# PADDLE_PDX_CACHE_HOME=

# PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK lo setea el código al arrancar (True).
# No hace falta copiarlo acá salvo que quieras forzar otro valor en el entorno.

# Opcional: PaddleOCR Official API (cloud SDK / AI Studio).
# El pipeline local PP-OCRv6 NO lo lee ni lo usa.
PADDLEOCR_API_TOKEN=
